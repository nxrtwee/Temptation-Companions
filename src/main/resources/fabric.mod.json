{
  "schemaVersion": 1,
  "id": "sexmod",
  "version": "${version}",
  "name": "Temptation Companions",
  "description": "Adult companion NPCs with animated scenes, an interaction menu and a cinematic scene camera.",
  "authors": [
    "nxrtweeTG"
  ],
  "contact": {
    "homepage": "https://github.com/nxrtwee/Temptation-Companions",
    "sources": "https://github.com/nxrtwee/Temptation-Companions",
    "issues": "https://github.com/nxrtwee/Temptation-Companions/issues"
  },
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.nxrtweetg.sexmod.SexmodMod"
    ],
    "client": [
      "com.nxrtweetg.sexmod.SexmodClient"
    ]
  },
  "mixins": [
    {
      "config": "sexmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": ">=4.9.3"
  }
}

